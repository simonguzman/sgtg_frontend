# Secretos del despliegue de producción (docker-compose.prod.yml). Copiar como .env.prod y llenar.
# .env.prod no se sube al repositorio. Guardar una copia segura fuera del servidor: sin JWT_SECRET las sesiones se
# cierran, y sin SGTG_AUDITORIA_CLAVE la auditoría anterior ya no se puede verificar.

# Contraseña del usuario root de MySQL: solo la usa el paso de migración
MYSQL_ROOT_PASSWORD=

# Contraseña del usuario de la aplicación (sgtg_app): solo letras y dígitos, al menos 24. openssl rand -hex 24
SGTG_DB_PASSWORD=

# Clave de los tokens (Base64, al menos 32 bytes): openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Clave de los sellos de la auditoría (al menos 32 caracteres, distinta de JWT_SECRET). No cambiarla después
SGTG_AUDITORIA_CLAVE=

# Administrador inicial: lo crea el paso de migración si no existe (luego se pueden borrar de este archivo)
SGTG_ADMIN_EMAIL=
SGTG_ADMIN_PASSWORD=
SGTG_ADMIN_DOCUMENTO=

# Opcionales: puertos publicados y carpetas de los certificados y de los desafíos de Let's Encrypt
# SGTG_PUERTO_HTTP=80
# SGTG_PUERTO_HTTPS=443
# SGTG_CERTIFICADOS=./certificados
# SGTG_ACME=./acme
