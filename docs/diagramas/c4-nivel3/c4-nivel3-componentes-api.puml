@startuml c4-nivel3-componentes-api
' C4 nivel 3 (componentes) de la API de SGTG. Generado por generar.py: no editar a mano.
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
skinparam dpi 110
UpdateElementStyle("component", $bgColor="#1E5A8E", $fontColor="#FFFFFF", $borderColor="#0B3D66")
UpdateElementStyle("container", $bgColor="#438DD5", $fontColor="#FFFFFF", $borderColor="#2E6295")
AddRelTag("p", $lineStyle=DashedLine())

title SGTG API — C4 nivel 3 (componentes)

Container(spa, "Aplicación de página única", "Angular", "Interfaz de los usuarios; consume la API.")
ContainerDb(db, "Base de datos", "MySQL", "Usuarios, trabajos de grado, notificaciones, sesiones y auditoría.")
ContainerDb(fs, "Almacenamiento de archivos", "Sistema de archivos del servidor", "Documentos PDF (máximo 20 MB) de cada trabajo, por tipo y versión.")
Container_Boundary(api, "API de la aplicación (Java y Spring Boot)") {
  Boundary(filtros, "Filtros de entrada") {
    Component(fCorr, "Filtro de correlación", "Servlet filter · CorrelacionFilter", "Asigna a cada petición un identificador que se conserva en el log y en la auditoría.")
    Component(fJwt, "Filtro de autenticación JWT", "Spring Security · JwtAuthenticationFilter", "Valida el token de acceso y registra al usuario y sus roles.")
    Component(fAud, "Filtro de auditoría", "Servlet filter · AuditoriaFilter", "Registra las operaciones que modifican datos, las descargas y los inicios de sesión.")
  }
  Boundary(controladores, "Controladores REST") {
    Component(cAuth, "Controlador de autenticación", "REST · AuthController", "Inicio de sesión, renovación de la sesión y cierre de sesión.")
    Component(cUsr, "Controlador de usuarios", "REST · UsuarioController", "Creación, edición, roles, activación, cambio del Comité y de contraseña.")
    Component(cPerf, "Controlador de perfiles académicos", "REST · PerfilController", "Vinculación y departamento del docente; programa del estudiante.")
    Component(cCat, "Controlador de catálogos", "REST · CatalogoController", "Departamentos y programas académicos.")
    Component(cCal, "Controlador del calendario", "REST · CalendarioController", "Festivos de ley y días no hábiles institucionales.")
    Component(cNot, "Controlador de notificaciones", "REST · NotificacionController", "Bandeja de entrada del usuario autenticado.")
    Component(cTG, "Controlador de trabajos de grado", "REST · TrabajoGradoController", "Operaciones de la propuesta, el anteproyecto, el trabajo en curso, las solicitudes especiales y la sustentación.")
    Component(cRel, "Controlador del reloj", "REST · RelojController", "Solo en desarrollo: adelanta la fecha y ejecuta la revisión diaria.")
  }
  Boundary(casos, "Casos de uso (dominio)") {
    Component(uAuth, "Casos de uso de autenticación", "ManageAuthCUImplAdapter", "Credenciales, sesiones y bloqueo por intentos fallidos.")
    Component(uUsr, "Casos de uso de usuarios", "ManageUsuarioCUImplAdapter", "Gestión de usuarios según el alcance de cada gestor.")
    Component(uPerf, "Casos de uso de perfiles", "ManagePerfilCUImplAdapter", "Registro y consulta de perfiles académicos.")
    Component(uCat, "Casos de uso de catálogos", "ManageCatalogoCUImplAdapter", "Registro y consulta de departamentos y programas.")
    Component(uCal, "Casos de uso del calendario", "ManageCalendarioCUImplAdapter", "Registro y consulta de días no hábiles.")
    Component(uNot, "Casos de uso de notificaciones", "ManageNotificacionCUImplAdapter", "Cada usuario consulta y marca solo sus notificaciones.")
    Component(uTG, "Casos de uso del trabajo de grado", "ManageTrabajoGradoCUImplAdapter", "Valida el puesto del usuario en el trabajo, guarda los archivos y delega las reglas al agregado.")
    Component(dTG, "Agregado TrabajoGrado", "Modelo de dominio", "Registro único que avanza por etapas y aplica las reglas del reglamento.")
    Component(notif, "Notificador del trabajo de grado", "NotificadorTrabajoGrado", "Genera las notificaciones de cada hecho y de los plazos.")
    Component(uSeg, "Casos de uso de seguridad", "ManageSeguridadCUImplAdapter", "Detecta alertas a partir de la auditoría reciente.")
  }
  Boundary(salida, "Adaptadores de salida") {
    Component(gAuth, "Servicios de sesión y tokens", "AuthService · JwtService · SesionService", "Verifican credenciales, emiten tokens y guardan las sesiones.")
    Component(gAcc, "Adaptador de intentos de acceso", "ManageIntentosAccesoGatewayImplAdapter", "Registra los intentos fallidos de inicio de sesión.")
    Component(gUsr, "Adaptador de usuarios", "ManageUserGatewayImplAdapter · JPA", "Usuarios y roles.")
    Component(gPerf, "Adaptador de perfiles", "ManagePerfilGatewayImplAdapter · JPA", "Perfiles de docentes y estudiantes.")
    Component(gCat, "Adaptador de catálogos", "ManageCatalogoGatewayImplAdapter · JPA", "Departamentos y programas.")
    Component(gCal, "Calendario hábil", "CalendarioHabilImplAdapter · JPA", "Días hábiles: sin fines de semana, festivos de Colombia ni días no hábiles.")
    Component(gNot, "Adaptador de notificaciones", "ManageNotificacionGatewayImplAdapter · JPA", "Notificaciones de la bandeja.")
    Component(gTG, "Adaptador de trabajos de grado", "ManageTrabajoGradoGatewayImplAdapter · JPA", "Guarda el trabajo de grado completo en un solo repositorio.")
    Component(gArch, "Adaptador de archivos", "ManageArchivoGatewayImplAdapter", "Guarda y entrega los PDF y calcula su huella.")
    Component(gAud, "Adaptador de auditoría", "ManageAuditoriaGatewayImplAdapter · JPA", "Auditoría encadenada con el estado antes y después de cada operación.")
    Component(gAle, "Adaptador de alertas", "ManageAlertaGatewayImplAdapter · JPA", "Guarda las alertas y avisa a los administradores.")
  }
  Boundary(tareas, "Tareas programadas") {
    Component(sVen, "Tarea de vencimientos", "Spring @Scheduled · 00:05", "Recordatorios de plazos, reanudación de suspensiones y cierre por vencimiento.")
    Component(sSeg, "Tareas de seguridad", "Spring @Scheduled · cada 5 min y 03:30", "Detección de alertas e integridad de la auditoría y los archivos.")
    Component(sLim, "Limpieza de accesos", "Spring @Scheduled · 03:00", "Borra intentos fallidos antiguos y sesiones vencidas.")
  }
}
